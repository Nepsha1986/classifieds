# Rendered by the nginx image's entrypoint (envsubst replaces only defined variables, e.g. API_UPSTREAM).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # A photo upload carries up to 10 files of 5 MB each.
    client_max_body_size 55m;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass ${API_UPSTREAM};
    }

    # Vite puts hashed bundles here: safe to cache forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Client-side routes all serve index.html, which is never cached so a new build is picked up.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
