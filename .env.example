# API
PORT=4000
DATABASE_URL=postgres://classifieds:classifieds@localhost:5432/classifieds
TEST_DATABASE_URL=postgres://classifieds:classifieds@localhost:5432/classifieds_test
# Photo storage; a relative path is resolved against apps/api.
UPLOAD_DIR=./uploads
# Auth (better-auth). Secret: at least 32 chars, required in production (e.g. `openssl rand -base64 32`).
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000
