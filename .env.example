# API
PORT=4000
DATABASE_URL=postgres://classifieds:classifieds@localhost:5432/classifieds
TEST_DATABASE_URL=postgres://classifieds:classifieds@localhost:5432/classifieds_test
# Photo storage; a relative path is resolved against apps/api.
UPLOAD_DIR=./uploads
# Auth (better-auth). Secret: at least 32 chars, required in production (e.g. `openssl rand -base64 32`).
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# Merchant portal (Vite). Empty VITE_API_URL = same origin: the dev server proxies /api and /uploads to
# API_PROXY_TARGET. Set VITE_API_URL (e.g. http://localhost:4000) to call the API cross-origin (CORS).
VITE_API_URL=
API_PROXY_TARGET=http://localhost:4000

# Public dashboard (Next.js), read at request time. API_URL: how the Next.js server reaches the API;
# PUBLIC_API_URL: how browsers reach it (photo URLs in the HTML), defaults to API_URL.
API_URL=http://localhost:4000
PUBLIC_API_URL=
